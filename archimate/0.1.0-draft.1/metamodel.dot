digraph "DTH-PHC overlay on the DPI-H reference architecture — metamodel in use" {
  graph [rankdir=TB, newrank=true, fontname="Helvetica", fontsize=11, nodesep=0.6, ranksep=1.3];
  node [shape=box, style="filled", fontname="Helvetica", fontsize=11, margin="0.14,0.08"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", fontcolor="#333333"];
  subgraph cluster_0 {
    label="Motivation"; class="mm-layer-motivation"; labeljust=l; style="rounded,filled"; fillcolor="#f7f7f7"; color="#bbbbbb"; fontcolor="#666666";
    rank=same;
    "Stakeholder" [label="Stakeholder
8 element(s)", class="mm-layer-motivation", fillcolor="#ccccff", URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#type-Stakeholder", target="_top", tooltip="Stakeholder: its elements"];
  }
  subgraph cluster_1 {
    label="Strategy"; class="mm-layer-strategy"; labeljust=l; style="rounded,filled"; fillcolor="#f7f7f7"; color="#bbbbbb"; fontcolor="#666666";
    rank=same;
    "Capability" [label="Capability
1 element(s)", class="mm-layer-strategy", fillcolor="#f5deaa", URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#type-Capability", target="_top", tooltip="Capability: its elements"];
  }
  subgraph cluster_2 {
    label="Business"; class="mm-layer-business"; labeljust=l; style="rounded,filled"; fillcolor="#f7f7f7"; color="#bbbbbb"; fontcolor="#666666";
    rank=same;
    "BusinessActor" [label="Business Actor
2 element(s)
(to itself: serves ×1)", class="mm-layer-business", fillcolor="#ffffb5", URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#type-BusinessActor", target="_top", tooltip="Business Actor: its elements"];
    "BusinessObject" [label="Business Object
1 element(s)", class="mm-layer-business", fillcolor="#ffffb5", URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#type-BusinessObject", target="_top", tooltip="Business Object: its elements"];
    "BusinessRole" [label="Business Role
11 element(s)
(to itself: serves ×10, aggregates ×2)", class="mm-layer-business", fillcolor="#ffffb5", URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#type-BusinessRole", target="_top", tooltip="Business Role: its elements"];
  }
  subgraph cluster_3 {
    label="Application"; class="mm-layer-application"; labeljust=l; style="rounded,filled"; fillcolor="#f7f7f7"; color="#bbbbbb"; fontcolor="#666666";
    rank=same;
    "ApplicationComponent" [label="Application Component
26 element(s)
(to itself: serves ×5, specialises ×4, flows to ×2)", class="mm-layer-application", fillcolor="#b5ffff", URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#type-ApplicationComponent", target="_top", tooltip="Application Component: its elements"];
    "ApplicationService" [label="Application Service
5 element(s)", class="mm-layer-application", fillcolor="#b5ffff", URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#type-ApplicationService", target="_top", tooltip="Application Service: its elements"];
  }
  "Stakeholder" -> "Capability" [style=invis, constraint=true, weight=10];
  "Capability" -> "BusinessActor" [style=invis, constraint=true, weight=10];
  "BusinessActor" -> "ApplicationComponent" [style=invis, constraint=true, weight=10];
  "BusinessActor" -> "BusinessRole" [label="assigned to ×7", class="mm-cat-structural mm-from-business mm-to-business", dir=both, arrowtail=dot, arrowhead=normal, URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#pattern-BusinessActor-BusinessRole", target="_top", tooltip="Business Actor → Business Role: its relationships"];
  "ApplicationComponent" -> "ApplicationService" [label="realises ×5", class="mm-cat-structural mm-from-application mm-to-application", style=dashed, arrowhead=empty, URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#pattern-ApplicationComponent-ApplicationService", target="_top", tooltip="Application Component → Application Service: its relationships"];
  "ApplicationService" -> "BusinessRole" [label="serves ×3", class="mm-cat-dependency mm-from-application mm-to-business", arrowhead=vee, URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#pattern-ApplicationService-BusinessRole", target="_top", tooltip="Application Service → Business Role: its relationships"];
  "ApplicationComponent" -> "Capability" [label="realises ×2", class="mm-cat-structural mm-from-application mm-to-strategy", style=dashed, arrowhead=empty, URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#pattern-ApplicationComponent-Capability", target="_top", tooltip="Application Component → Capability: its relationships"];
  "ApplicationComponent" -> "BusinessObject" [label="accesses ×1", class="mm-cat-dependency mm-from-application mm-to-business", style=dotted, arrowhead=vee, arrowsize=0.6, URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#pattern-ApplicationComponent-BusinessObject", target="_top", tooltip="Application Component → Business Object: its relationships"];
  "ApplicationComponent" -> "BusinessRole" [label="serves ×1", class="mm-cat-dependency mm-from-application mm-to-business", arrowhead=vee, URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#pattern-ApplicationComponent-BusinessRole", target="_top", tooltip="Application Component → Business Role: its relationships"];
  "ApplicationService" -> "ApplicationComponent" [label="flows to ×1", class="mm-cat-dynamic mm-from-application mm-to-application", style=dashed, arrowhead=normal, URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#pattern-ApplicationService-ApplicationComponent", target="_top", tooltip="Application Service → Application Component: its relationships"];
  "BusinessRole" -> "BusinessActor" [label="serves ×1", class="mm-cat-dependency mm-from-business mm-to-business", arrowhead=vee, URL="../../en/dth-phc/archimate/0.1.0-draft.1/metamodel/#pattern-BusinessRole-BusinessActor", target="_top", tooltip="Business Role → Business Actor: its relationships"];
}
