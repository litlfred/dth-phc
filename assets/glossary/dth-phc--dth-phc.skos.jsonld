    {
      "@id": "https://litlfred.github.io/dth-phc/v0/ns#glossary/dth-phc/output",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-phc/v0/ns#glossary/dth-phc"
      },
      "skos:prefLabel": [
        {
          "@value": "Output"
        }
      ],
      "skos:definition": [
        {
          "@value": "In the context of requirements gathering or decision support logic, for each combination of input entries, the output is what will result in the conditions of the rule being met. This could be a single output value that would become an input in a subsequent decision table, or it could be a resulting action, activity or task in a business process."
        }
      ],
      "skos:scopeNote": "Handbook definition, quoted. Open: not adopted, nothing chosen between alternatives.",
