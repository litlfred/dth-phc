        "Health Service User's Health Records"
      ],
      "skos:definition": [
        {
          "@value": "The record of health information, including health services, clinical observations, diagnosis and any other interactions between a health service user and the health worker or community health worker. The record may be retained by the health-care facility or by the health service user."
        }
      ],
      "skos:scopeNote": "Handbook definition, quoted. Open: not adopted, nothing chosen between alternatives.",
