    {
      "@id": "https://litlfred.github.io/dth-phc/v0/ns#glossary/dth-phc/rule",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-phc/v0/ns#glossary/dth-phc"
      },
      "skos:prefLabel": [
        {
          "@value": "Rule"
        }
      ],
      "skos:definition": [
        {
          "@value": "In the context of a decision-support table, each rule contains input and output entries. The input entries are the condition, and the output entries are the conclusion of the rule. If each input entry (condition) is satisfied, then the rule is satisfied, and the decision result contains the output entries (conclusion) of this rule (22)."
        }
      ],
      "skos:scopeNote": "Handbook definition, quoted. Open: not adopted, nothing chosen between alternatives.",
