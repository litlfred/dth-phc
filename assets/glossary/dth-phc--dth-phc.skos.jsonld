      },
      "skos:prefLabel": [
        {
          "@value": "Input"
        }
      ],
      "skos:definition": [
        {
          "@value": "The input entry in a decision-support table is a “condition” for the rule to be met. There can be more than one input for the rule. Thus, if the input data are the same as the inputs listed in the decision- support table, then that rule is considered met – leading to the subsequent output or action."
        }
      ],
      "skos:scopeNote": "Handbook definition, quoted. Open: not adopted, nothing chosen between alternatives.",
