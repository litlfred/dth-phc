    {
      "@id": "https://litlfred.github.io/dth-phc/v0/ns#glossary/dth-phc/smart-guidelines",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-phc/v0/ns#glossary/dth-phc"
      },
      "skos:prefLabel": [
        {
          "@value": "SMART Guidelines"
        }
      ],
      "skos:altLabel": [
        "SMART",
        "Standards-based, machine-readable, adaptive, requirements-based and testable"
      ],
      "skos:definition": [
        {
          "@value": "Standards-based, Machine-readable, Adaptive, Requirements-based, and Testable Guidelines are recommended digital capabilities, health and data content aligned with normative recommendations. They represent packages of comprehensive documentation and reusable digital health components (e.g. health content, interoperability standards, code libraries, algorithms, technical and operational specifications) that facilitate country adaptation and adoption of clinical and public health protocols, health systems strengthening recommendations, and data and interoperability standards into digital health information systems with fidelity. SMART Guidelines serve as a starting point and as foundational specifications to advance the development of robust person-centred digital systems. These specifications are software-agnostic, context-agnostic, and are applicable to all levels of digital maturity (10,23)."
        }
      ],
      "skos:notation": "SMART",
      "skos:scopeNote": "Handbook definition, quoted. Open: not adopted, nothing chosen between alternatives.",
      "skos:related": [
