      },
      "skos:prefLabel": [
        {
          "@value": "Open Standards"
        }
      ],
      "skos:altLabel": [
        "Open standards"
      ],
      "skos:definition": [
        {
          "@value": "Standards that are documented and made freely available to the public, which are developed, approved and maintained via a collaborative and consensus-driven process. Open standards facilitate interoperability and data exchange and are intended for widespread adoption (20)."
        }
      ],
      "skos:scopeNote": "Handbook definition, quoted. Open: not adopted, nothing chosen between alternatives.",
