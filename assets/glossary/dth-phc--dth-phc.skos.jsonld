      ],
      "skos:altLabel": [
        "Technical debt"
      ],
      "skos:definition": [
        {
          "@value": "Technical debt in software development and systems architecture describes the risk of taking shortcuts and making short-term fixes, which later require costly revisions and add-ons; rather than investing in carefully designed, robust solutions, which may cost more upfront, but have lower maintenance and feature development costs over time (11)."
        }
      ],
      "skos:scopeNote": "Handbook definition, quoted. Open: not adopted, nothing chosen between alternatives.",
