      "skos:definition": [
        {
          "@value": "Stores routinely collected aggregate healthcare data and facilitates their analysis, with the goal of improving the quality of health services.(1,4)"
        }
      ],
      "skos:scopeNote": "Cited as: Classification of digital interventions, services and applications in health: a shared language to describe the uses of digital technology for health, 2nd ed. Geneva: World Health Organization; 2023. Services and application types, D6. Quoted verbatim from the L1 text (line breaks joined). A candidate from another WHO publication, never the handbook's own definition.",
      "dcterms:source": "who-iris/library/9789240081949-eng/sections/page-057.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/source-candidates/open-standards--who-dth-product-catalogue-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/source-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Open standards"
        }
      ],
      "skos:definition": [
        {
          "@value": "Standards that are documented and made freely available to the public, which are developed, approved, and maintained via a collaborative and consensus driven process. Open standards facilitate interoperability and data exchange and are intended for widespread adoption."
        }
      ],
      "skos:scopeNote": "Cited as: Digital transformation handbook for health product catalogue. Geneva: World Health Organization; 2024. Glossary. Quoted verbatim from the L1 text (line breaks joined). A candidate from another WHO publication, never the handbook's own definition.",
