iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-d79aa0eec0584b0792b44bca408afeb6.jsonld","name":"DPI-F Security & Consent Module"}],"views":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/views/id-8c5dd12b8d4e425184f6003d0513d569.jsonld","name":"Interoperability Layer"},{"iri":"https://litlfred.github.io/dth-phc/archimate/0.1.0-draft.1/views/id-bcf04de52bb05c3a932bbfdd36d7ae4f.jsonld","name":"Person-centred point of service (PCPOSS)"}]},"interoperabilityTypes":[{"id":"syntactic","name":"Syntactic interoperability","altName":"Structural interoperability","definition":"Ability of two or more systems to communicate and exchange structured data using specified data formats and communication protocols (e.g. HL7 FHIR, DICOM).","archimateElements":["id-80856538cbd44167a37b276e38c994c3","id-3c5d846710034c4595e206e748d65e36"]},{"id":"semantic","name":"Semantic interoperability","definition":"Ability of systems to exchange data with unambiguous, shared meaning through standardized data models, terminologies, classifications and coding schemes (e.g. ICD-11, LOINC, SNOMED-GPS).","archimateElements":["id-3f41de2b51c24041b08243bf72b140d1","id-c0d39bf67fe64f54b07fbeb9bf37d404"]},{"id":"organizational","name":"Organizational interoperability","definition":"Coordination of business processes, workflows, responsibilities and expectations across organizations and care levels so information is exchanged in a timely, actionable manner.","archimateElements":["id-02200ff02be649ada1bf34a0a4d8e594","id-18bf324b7b4753e0aeff853e6bcb6adc"]},{"id":"legal","name":"Legal interoperability","definition":"Alignment of legal frameworks, data protection, privacy, consent and regulatory policies enabling lawful cross-organization and cross-border health data exchange.","archimateElements":["id-d79aa0eec0584b0792b44bca408afeb6"]}]},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-phc/ns/context/v1.jsonld",{"@base":"https://litlfred.