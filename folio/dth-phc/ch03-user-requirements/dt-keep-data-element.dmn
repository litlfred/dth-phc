<?xml version="1.0" encoding="UTF-8"?>
<!--
  Data element retention decision table — Section 3.4.4, Fig. 12
  ("Is each and every data element collected truly needed?")
  L1 source: who-iris/library/9789240093362-eng/sections/sec-015-34-streamline-data-collection-and-indicator-repo.md
  L1 block:  who-iris/library/9789240093362-eng/blocks/prose-sec-015.jsonld (pages 39-42)

  Evaluates the three questions of Fig. 12:
    1. Is the data element duplicated?
    2. Is the data element needed for service delivery or accountability (an indicator)?
    3. Is the data element orphaned?
  Returns whether to keep or remove the data element in the consolidated data
  dictionary (3.4.5, 3.5) and the reconciliation/linkage action required.
-->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="Definitions_KeepDataElement"
             name="Data element retention (3.4.4, Fig. 12)"
             namespace="https://litlfred.github.io/dth-phc/decisions">
  <decision id="Decision_KeepDataElement" name="Data element retention (3.4.4, Fig. 12)">
    <description>Apply the data-minimization and streamlining rules of Section 3.4.4 and Fig. 12 (prose-sec-015, page 41) to decide whether a data element is kept in or removed from the consolidated data dictionary.</description>
    <decisionTable id="Table_KeepDataElement" hitPolicy="FIRST">
      <input id="In_Duplicated" label="duplicated?">
        <inputExpression id="Expr_Duplicated" typeRef="boolean"><text>duplicated</text></inputExpression>
      </input>
      <input id="In_Orphaned" label="orphaned?">
        <inputExpression id="Expr_Orphaned" typeRef="boolean"><text>orphaned</text></inputExpression>
      </input>
      <input id="In_Needed" label="needed for care or for an indicator?">
        <inputExpression id="Expr_Needed" typeRef="boolean"><text>neededForCareOrIndicator</text></inputExpression>
      </input>
      <output id="Out_KeepOrRemove" name="decision" label="keep or remove" typeRef="string" />
      <output id="Out_Action" name="action" label="action to be taken (Fig. 12)" typeRef="string" />

      <rule id="Rule_NotNeeded_Remove">
        <description>Fig. 12, Question 2: Under data minimization, only data elements required for health service delivery (clinical decision-making, care provision) or accountability (mandatory indicator reporting) are essential. Remove data elements not needed for either purpose.</description>
        <inputEntry id="IE_NotNeeded_1"><text>-</text></inputEntry>
        <inputEntry id="IE_NotNeeded_2"><text>-</text></inputEntry>
        <inputEntry id="IE_NotNeeded_3"><text>false</text></inputEntry>
        <outputEntry id="OE_NotNeeded_1"><text>"remove"</text></outputEntry>
        <outputEntry id="OE_NotNeeded_2"><text>"Remove data element not needed for service delivery or indicator reporting (Fig. 12, question 2)"</text></outputEntry>
      </rule>

      <rule id="Rule_DuplicatedAndOrphaned_ReconcileLinkAndKeep">
        <description>Fig. 12, Questions 1 and 3: Essential data element that is both duplicated across forms/labels and orphaned from its primary data element. Reconcile duplicates into one element with one label and link to its primary data element.</description>
        <inputEntry id="IE_DupOrph_1"><text>true</text></inputEntry>
        <inputEntry id="IE_DupOrph_2"><text>true</text></inputEntry>
        <inputEntry id="IE_DupOrph_3"><text>true</text></inputEntry>
        <outputEntry id="OE_DupOrph_1"><text>"keep"</text></outputEntry>
        <outputEntry id="OE_DupOrph_2"><text>"Reconcile duplicated data elements into a single element collected once, link to primary data element, and keep (Fig. 12, questions 1 and 3)"</text></outputEntry>
      </rule>

      <rule id="Rule_Duplicated_ReconcileAndKeep">
        <description>Fig. 12, Question 1: Essential data element duplicated across forms or under different labels. Reconcile into a single data element collected once with one label.</description>
        <inputEntry id="IE_Dup_1"><text>true</text></inputEntry>
        <inputEntry id="IE_Dup_2"><text>false</text></inputEntry>
        <inputEntry id="IE_Dup_3"><text>true</text></inputEntry>
        <outputEntry id="OE_Dup_1"><text>"keep"</text></outputEntry>
        <outputEntry id="OE_Dup_2"><text>"Reconcile duplicated data elements into a single data element collected once with one label, and keep (Fig. 12, question 1)"</text></outputEntry>
      </rule>

      <rule id="Rule_Orphaned_LinkAndKeep">
        <description>Fig. 12, Question 3: Essential data element that is orphaned (dependent on a primary data element linkage that is missing). Link it to its relevant primary data element and keep.</description>
        <inputEntry id="IE_Orph_1"><text>false</text></inputEntry>
        <inputEntry id="IE_Orph_2"><text>true</text></inputEntry>
        <inputEntry id="IE_Orph_3"><text>true</text></inputEntry>
        <outputEntry id="OE_Orph_1"><text>"keep"</text></outputEntry>
        <outputEntry id="OE_Orph_2"><text>"Link orphaned data element to its relevant primary data element and keep (Fig. 12, question 3)"</text></outputEntry>
      </rule>

      <rule id="Rule_EssentialClean_Keep">
        <description>Fig. 12, Questions 1-3: Data element is needed for service delivery or accountability, is not duplicated, and is not orphaned. Keep in the consolidated data dictionary (3.4.5, 3.5).</description>
        <inputEntry id="IE_Keep_1"><text>false</text></inputEntry>
        <inputEntry id="IE_Keep_2"><text>false</text></inputEntry>
        <inputEntry id="IE_Keep_3"><text>true</text></inputEntry>
        <outputEntry id="OE_Keep_1"><text>"keep"</text></outputEntry>
        <outputEntry id="OE_Keep_2"><text>"Keep data element in consolidated data dictionary (3.4.5, 3.5)"</text></outputEntry>
      </rule>
      <rule id="Rule_Unknown">
        <description>Unknown: at least one input has not been answered, so the source gives no outcome. Answer every input question first. (House rule: every table has an explicit unknown outcome, dth-phc#1 R3.)</description>
        <inputEntry id="IE_KeepDataElementUnknown_1"><text>-</text></inputEntry>
        <inputEntry id="IE_KeepDataElementUnknown_2"><text>-</text></inputEntry>
        <inputEntry id="IE_KeepDataElementUnknown_3"><text>-</text></inputEntry>
        <outputEntry id="OE_KeepDataElementUnknown_1"><text>"unknown"</text></outputEntry>
        <outputEntry id="OE_KeepDataElementUnknown_2"><text>"Answer every input question before this decision is made."</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
