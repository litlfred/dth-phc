<?xml version="1.0" encoding="UTF-8"?>
<!--
  Scale-up readiness and legacy system phase-out — Sections 6.1 and 6.2
  L1 sources:
    - who-iris/library/9789240093362-eng/sections/sec-029-61-determine-readiness-for-scaling-up.md (prose-sec-029, pages 66-68)
    - who-iris/library/9789240093362-eng/sections/sec-030-62-plan-for-phase-out-of-legacy-systems.md (prose-sec-030, pages 68-70)

  Evaluates the three readiness conditions stated in Sections 6.1 and 6.2:
    1. Is the PCPOSS ready to be scaled up? (6.1)
    2. Is the existing health system ready to phase out paper and legacy systems? (6.1)
    3. Are the country-defined SMART objectives and benchmarks met? (6.2, Table 5)
  Inputs only: no numeric thresholds are invented here because any benchmark comes
  from the country's own objectives, as Section 6.2 states.
-->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="Definitions_ReadyToScaleUp"
             name="Scale-up readiness and legacy system phase-out (6.1, 6.2)"
             namespace="https://litlfred.github.io/dth-phc/decisions">
  <decision id="Decision_ReadyToScaleUp" name="Scale-up readiness and legacy system phase-out (6.1, 6.2)">
    <description>Determine whether to proceed with scaling up the PCPOSS and staged phase-out of paper/legacy systems based on PCPOSS readiness (6.1), health-system readiness (6.1), and achievement of country-defined SMART objectives (6.2, Table 5). No thresholds are invented.</description>
    <decisionTable id="Table_ReadyToScaleUp" hitPolicy="FIRST">
      <input id="In_PcpossReady" label="PCPOSS ready?">
        <inputExpression id="Expr_PcpossReady" typeRef="boolean"><text>pcpossReady</text></inputExpression>
      </input>
      <input id="In_HealthSystemReady" label="health system ready?">
        <inputExpression id="Expr_HealthSystemReady" typeRef="boolean"><text>healthSystemReady</text></inputExpression>
      </input>
      <input id="In_ObjectivesMet" label="objectives met?">
        <inputExpression id="Expr_ObjectivesMet" typeRef="boolean"><text>objectivesMet</text></inputExpression>
      </input>
      <output id="Out_Proceed" name="outcome" label="proceed or not" typeRef="string" />
      <output id="Out_Guidance" name="guidance" label="handbook guidance (6.1, 6.2, 6.4)" typeRef="string" />

      <rule id="Rule_Ready_Proceed">
        <description>Sections 6.1, 6.2 and 6.4: Both the PCPOSS and the health system are ready and country-defined objectives (Table 5) are met. Proceed with scale-up and staged region-by-region phase-out of paper/legacy systems while retaining a backup paper mechanism for downtime and emergencies.</description>
        <inputEntry id="IE_Proc_1"><text>true</text></inputEntry>
        <inputEntry id="IE_Proc_2"><text>true</text></inputEntry>
        <inputEntry id="IE_Proc_3"><text>true</text></inputEntry>
        <outputEntry id="OE_Proc_1"><text>"proceed"</text></outputEntry>
        <outputEntry id="OE_Proc_2"><text>"Proceed with scale-up and staged phase-out of paper/legacy systems while retaining paper backup SOPs (6.1, 6.2, 6.4)"</text></outputEntry>
      </rule>

      <rule id="Rule_PcpossNotReady">
        <description>Section 6.1: The PCPOSS itself has not yet demonstrated technical, functional or maintenance readiness for scale-up.</description>
        <inputEntry id="IE_NotP_1"><text>false</text></inputEntry>
        <inputEntry id="IE_NotP_2"><text>-</text></inputEntry>
        <inputEntry id="IE_NotP_3"><text>-</text></inputEntry>
        <outputEntry id="OE_NotP_1"><text>"not"</text></outputEntry>
        <outputEntry id="OE_NotP_2"><text>"Do not proceed: remediate PCPOSS technical, functional or support readiness using the MAPS toolkit (6.1)"</text></outputEntry>
      </rule>

      <rule id="Rule_HealthSystemNotReady">
        <description>Section 6.1: Foundational health-system elements (power, connectivity, governance, policies recognizing digital records, resources) are not yet in place in target scale-up areas.</description>
        <inputEntry id="IE_NotH_1"><text>-</text></inputEntry>
        <inputEntry id="IE_NotH_2"><text>false</text></inputEntry>
        <inputEntry id="IE_NotH_3"><text>-</text></inputEntry>
        <outputEntry id="OE_NotH_1"><text>"not"</text></outputEntry>
        <outputEntry id="OE_NotH_2"><text>"Do not proceed: establish health-system enabling environment, infrastructure and legal recognition policies (6.1, 6.2)"</text></outputEntry>
      </rule>

      <rule id="Rule_ObjectivesNotMet">
        <description>Section 6.2: Country-defined SMART objectives and benchmarks across functionality, user adoption, efficiency, quality and outcomes (Table 5) have not yet been met. Inputs are explicit so that a missing answer falls to Rule_Unknown.</description>
        <inputEntry id="IE_NotO_1"><text>true</text></inputEntry>
        <inputEntry id="IE_NotO_2"><text>true</text></inputEntry>
        <inputEntry id="IE_NotO_3"><text>false</text></inputEntry>
        <outputEntry id="OE_NotO_1"><text>"not"</text></outputEntry>
        <outputEntry id="OE_NotO_2"><text>"Do not proceed: continue monitoring and addressing bottlenecks until country-defined SMART objectives are met (6.2, 6.3)"</text></outputEntry>
      </rule>
      <rule id="Rule_Unknown">
        <description>Unknown: at least one input has not been answered, so the source gives no outcome. Answer every input question first. (House rule: every table has an explicit unknown outcome, dth-phc#1 R3.)</description>
        <inputEntry id="IE_ReadyToScaleUpUnknown_1"><text>-</text></inputEntry>
        <inputEntry id="IE_ReadyToScaleUpUnknown_2"><text>-</text></inputEntry>
        <inputEntry id="IE_ReadyToScaleUpUnknown_3"><text>-</text></inputEntry>
        <outputEntry id="OE_ReadyToScaleUpUnknown_1"><text>"unknown"</text></outputEntry>
        <outputEntry id="OE_ReadyToScaleUpUnknown_2"><text>"Answer every input question before this decision is made."</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
