<?xml version="1.0" encoding="UTF-8"?>
<!--
  Starting scenario decision table — Section 2.1 (Targeted scenarios of digital readiness)
  L1 source: who-iris/library/9789240093362-eng/sections/sec-007-21-targeted-scenarios-of-digital-readiness.md
  L1 block:  who-iris/library/9789240093362-eng/blocks/prose-sec-007.jsonld (pages 22-23)

  Determines which of the handbook's two targeted digital-readiness scenarios
  applies to a health system ("paper only" vs "partly digitized") and how the
  implementation team enters the Chapter 3 requirements-gathering workflow.
-->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="Definitions_StartingScenario"
             name="Starting scenario of digital readiness (2.1)"
             namespace="https://litlfred.github.io/dth-phc/decisions">
  <decision id="Decision_StartingScenario" name="Starting scenario (2.1)">
    <description>Classify the country or facility digital-readiness starting scenario from Section 2.1 (prose-sec-007, pages 22-23) and identify the entry step in Chapter 3.</description>
    <decisionTable id="Table_StartingScenario" hitPolicy="FIRST">
      <input id="In_AnyPcposs" label="any PCPOSS in place?">
        <inputExpression id="Expr_AnyPcposs" typeRef="boolean"><text>anyPcpossInPlace</text></inputExpression>
      </input>
      <input id="In_Comprehensive" label="comprehensive and interoperable?">
        <inputExpression id="Expr_Comprehensive" typeRef="boolean"><text>comprehensiveAndInteroperable</text></inputExpression>
      </input>
      <output id="Out_Scenario" name="scenario" label="starting scenario" typeRef="string" />
      <output id="Out_EntryStep" name="entryStep" label="entry step" typeRef="string" />

      <rule id="Rule_PaperOnly">
        <description>Section 2.1 (Starting from a paper-only system): no PCPOSS is in place; only paper-based records are used at the point of care for service delivery and reporting. Enter at 3.1 and complete all five streamlining steps in 3.4, including 3.4.1 paper form inventory and 3.4.2 form data mapping.</description>
        <inputEntry id="IE_Paper_1"><text>false</text></inputEntry>
        <inputEntry id="IE_Paper_2"><text>-</text></inputEntry>
        <outputEntry id="OE_Paper_1"><text>"paper only"</text></outputEntry>
        <outputEntry id="OE_Paper_2"><text>"3.1 Follow key requirement-gathering methods (including 3.4.1 paper form inventory and 3.4.2 form data mapping)"</text></outputEntry>
      </rule>

      <rule id="Rule_PartlyDigitized_Siloed">
        <description>Section 2.1 (Starting with some parts of the system already digitized): disparate or disconnected PCPOSSs exist with limited functionality, no interoperability, or parallel paper registers. Enter at 3.1 to document existing system features and combine or upgrade siloed PCPOSSs into a comprehensive, interoperable PCPOSS (3.4.1-3.4.2 remain recommended when replacing paper registers in their entirety).</description>
        <inputEntry id="IE_Partly_1"><text>true</text></inputEntry>
        <inputEntry id="IE_Partly_2"><text>false</text></inputEntry>
        <outputEntry id="OE_Partly_1"><text>"partly digitized"</text></outputEntry>
        <outputEntry id="OE_Partly_2"><text>"3.1 Follow key requirement-gathering methods (assess existing PCPOSS features; 3.4.1-3.4.2 optional if data list is established, recommended for full paper replacement)"</text></outputEntry>
      </rule>

      <rule id="Rule_PartlyDigitized_UpdateCarePathways">
        <description>Section 2.1: a PCPOSS is in place and being updated to better integrate additional care pathways or health domains. Inputs are explicit so that a missing answer falls to Rule_Unknown.</description>
        <inputEntry id="IE_Update_1"><text>true</text></inputEntry>
        <inputEntry id="IE_Update_2"><text>true</text></inputEntry>
        <outputEntry id="OE_Update_1"><text>"partly digitized"</text></outputEntry>
        <outputEntry id="OE_Update_2"><text>"3.1 Follow key requirement-gathering methods (update existing PCPOSS to integrate care pathways; skip 3.4.1-3.4.2 where data list is already established)"</text></outputEntry>
      </rule>
      <rule id="Rule_Unknown">
        <description>Unknown: at least one input has not been answered, so the source gives no outcome. Answer every input question first. (House rule: every table has an explicit unknown outcome, dth-phc#1 R3.)</description>
        <inputEntry id="IE_StartingScenarioUnknown_1"><text>-</text></inputEntry>
        <inputEntry id="IE_StartingScenarioUnknown_2"><text>-</text></inputEntry>
        <outputEntry id="OE_StartingScenarioUnknown_1"><text>"unknown"</text></outputEntry>
        <outputEntry id="OE_StartingScenarioUnknown_2"><text>"Answer every input question before this decision is made."</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
