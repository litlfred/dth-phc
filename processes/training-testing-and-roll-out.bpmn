<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/v0/processes/ns#"
                  xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/v0/processes/ns#"
                  id="Definitions_Process_TrainingTestingAndRollOut"
                  targetNamespace="https://litlfred.github.io/dth-phc/workflows"
                  exporter="folio-assistant" exporterVersion="1">
  <bpmn:import namespace="https://litlfred.github.io/bootstrap/v0/processes/ns#" location="https://litlfred.github.io/bootstrap/v0/processes/ns.jsonld" importType="http://www.w3.org/ns/json-ld"/>
  <bpmn:resource id="pers:public-health-authority" name="Public health authority"/>
  <bpmn:resource id="pers:business-analyst" name="Business analyst"/>
  <bpmn:resource id="pers:technology-partner" name="Technology partner (vendor)"/>
  <bpmn:resource id="pers:implementing-team" name="Implementing team"/>
  <bpmn:resource id="pers:health-worker" name="Health worker"/>
  <bpmn:resource id="pers:health-informatician" name="Health informatician"/>
  <bpmn:resource id="pers:software-engineer" name="Software engineer"/>
  <bpmn:resource id="pers:solutions-architect" name="Solutions architect"/>
  <bpmn:resource id="pers:designer" name="Designer"/>
  <bpmn:resource id="pers:user-researcher" name="User researcher"/>
  <bpmn:resource id="pers:monitoring-and-evaluation-specialist" name="Monitoring and evaluation (M&amp;E) specialist"/>
  <bpmn:resource id="pers:clerk" name="Clerk (facility registration and records staff)"/>
  <bpmn:resource id="pers:supervisor" name="Supervisor / health facility manager"/>
  <bpmn:resource id="pers:health-service-user" name="Health service user (patient / client)"/>
  <bpmn:resource id="pers:system-ehr" name="Electronic health record (EHR) system"/>
  <bpmn:resource id="pers:system-dss" name="Decision-support system (DSS)"/>
  <bpmn:resource id="pers:system-cbis" name="Community-based information system (CBIS)"/>
  <bpmn:resource id="pers:system-phr" name="Personal health record (PHR) system"/>
  <bpmn:resource id="pers:donors-and-development-partners" name="Donors, development partners and implementing partners"/>
  <bpmn:collaboration id="Collaboration_Process_TrainingTestingAndRollOut">
    <bpmn:participant id="Participant_Process_TrainingTestingAndRollOut" name="WHO DTH for Primary Health Care — Chapter 5: Conduct training, testing and roll-out (5.1-5.4)" processRef="Process_TrainingTestingAndRollOut"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_TrainingTestingAndRollOut" name="Conduct training, testing and roll-out (Ch 5, 5.1-5.4)" isExecutable="false">
    <bpmn:documentation>Prepare policies and training curricula, conduct competency-based end-user training and maintenance training, execute user acceptance testing (UAT) with curated test cases and test data, deploy the PCPOSS to production sites, and operate the continuous feedback and system maintenance loop.

L1 source anchors: who-iris/library/9789240093362-eng sections 5.1 (prose-sec-025), 5.2 and 5.2.1 (prose-sec-026), 5.3 (prose-sec-027), and 5.4 (prose-sec-028). Aligned with smart-base DAK `test-scenario` and cat-harness `test-plan-execution` / `test-data-curation` (workplan 3f).</bpmn:documentation>
    <bpmn:extensionElements>
      <cat-harness.processes:policy enforcement="advisory"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_Process_TrainingTestingAndRollOut">
      <bpmn:lane id="Lane-Ch5-PHA" name="Public health authority" partitionElementRef="pers:public-health-authority">
        <bpmn:documentation>Persona block pers:public-health-authority. Implements policies on cybersecurity, privacy, confidentiality, electronic signatures, data use, ID management and content management, and provides political and change-management support for local adoption (Ch 5 opener panel).</bpmn:documentation>
        <bpmn:flowNodeRef>Start_Ch5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5_0_Policies</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane-Ch5-Impl" name="Implementing team" partitionElementRef="pers:implementing-team">
        <bpmn:documentation>Persona block pers:implementing-team. Develops tailored training materials, conducts training of trainers and health-worker training (5.1.1), designs UAT test cases and curates realistic/edge-case test data (5.2.1), coordinates UAT (5.2), and operates the feedback management SOP and post-deployment monitoring (5.4).</bpmn:documentation>
        <bpmn:flowNodeRef>Task_5_1_1_TrainUsers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5_2_1_CurateTestCases</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_UatPassed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5_4_FeedbackAndMaintenance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MaintenanceUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Ch5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane-Ch5-Engineer" name="Software engineer / technology partner" partitionElementRef="pers:software-engineer">
        <bpmn:documentation>Persona blocks pers:software-engineer and pers:technology-partner. Trains local technology partners on system maintenance (5.1.2), resolves UAT bugs and usability roadblocks (5.2), leads production deployment across infrastructure, hardware, data migration and configuration (5.3), and delivers software updates during roll-out (5.4).</bpmn:documentation>
        <bpmn:flowNodeRef>Task_5_1_2_TrainMaintenance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5_2_UpdatePcposs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5_3_DeploySystem</bpmn:flowNodeRef>
      
        <bpmn:childLaneSet id="ChildLaneSet_Lane-Ch5-Engineer">
          <bpmn:lane id="Lane-Ch5-Engineer-technology-partner" name="Technology partner (vendor)" partitionElementRef="pers:technology-partner"/>
        </bpmn:childLaneSet>
      </bpmn:lane>
      <bpmn:lane id="Lane-Ch5-Users" name="Targeted health workers &amp; UAT end-users" partitionElementRef="pers:health-worker">
        <bpmn:documentation>Persona blocks pers:health-worker and pers:health-service-user. Participate in competency-based training (5.1.1), execute UAT in existing workflows to report bugs and usability roadblocks (5.2), use the deployed PCPOSS in routine care (5.3), and submit ongoing feedback (5.4).</bpmn:documentation>
        <bpmn:flowNodeRef>Task_5_2_RunUat</bpmn:flowNodeRef>
      
        <bpmn:childLaneSet id="ChildLaneSet_Lane-Ch5-Users">
          <bpmn:lane id="Lane-Ch5-Users-clerk" name="Clerk (facility registration and records staff)" partitionElementRef="pers:clerk"/>
          <bpmn:lane id="Lane-Ch5-Users-health-service-user" name="Health service user (patient / client)" partitionElementRef="pers:health-service-user"/>
          <bpmn:lane id="Lane-Ch5-Users-supervisor" name="Supervisor / health facility manager" partitionElementRef="pers:supervisor"/>
        </bpmn:childLaneSet>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Ch5" name="Beta version of PCPOSS available (Ch 5 input)">
      <bpmn:documentation>Chapter 5 opener panel input (prose-sec-025, page 62): Beta version of the PCPOSS from Chapter 4.</bpmn:documentation>
      <bpmn:outgoing>Flow_Ch5_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_5_0_Policies" name="5.0 Implement cybersecurity, privacy, e-signature, data-use &amp; ID policies">
      <bpmn:documentation>Chapter 5 opener panel (prose-sec-025, page 62): Public health authority implements policies surrounding cybersecurity, privacy, confidentiality, acceptability of electronic signatures, data use, identification management and content management.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="methodology-adoption"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ch5_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Ch5_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_5_1_1_TrainUsers" name="5.1.1 Develop tailored curriculum &amp; conduct training of trainers and end-users">
      <bpmn:documentation>Section 5.1.1 (prose-sec-025, pages 62-63): Develop culturally and linguistically tailored competency-based training materials, test curriculum at small scale, train trainers for first-line support, and train health workers (including device familiarization).</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="methodology-adoption"/>
      </bpmn:extensionElements>
      <bpmn:ioSpecification id="Task_5_1_1_TrainUsers_IO">
        <bpmn:dataInput id="Task_5_1_1_TrainUsers_In_1" name="Beta version of the PCPOSS"/>
        <bpmn:dataOutput id="Task_5_1_1_TrainUsers_Out_1" name="Training materials"/>
        <bpmn:inputSet id="Task_5_1_1_TrainUsers_InputSet">
          <bpmn:dataInputRefs>Task_5_1_1_TrainUsers_In_1</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="Task_5_1_1_TrainUsers_OutputSet">
          <bpmn:dataOutputRefs>Task_5_1_1_TrainUsers_Out_1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:incoming>Flow_Ch5_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Ch5_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_5_1_2_TrainMaintenance" name="5.1.2 Train local technology partner(s) on system maintenance &amp; troubleshooting">
      <bpmn:documentation>Section 5.1.2 (prose-sec-025, pages 63-64): Train local technology partner(s) on in-depth system architecture, troubleshooting and customization so they can maintain the PCPOSS without external intervention.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="methodology-adoption"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ch5_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Ch5_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_5_2_1_CurateTestCases" name="5.2.1 Create UAT test cases &amp; curate realistic and edge-case test data">
      <bpmn:documentation>Section 5.2.1 (prose-sec-026, pages 64-65): Create test cases from Section 3.2.2 and Section 4.3.2 use cases with expected outcomes, and curate test data reflecting real-time settings plus edge cases (aligned with DAK `test-scenario` and cat-harness `test-data-curation`).</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="test-data-curation"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ch5_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Ch5_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_5_2_RunUat" name="5.2 Execute user acceptance testing (UAT) in existing workflows">
      <bpmn:documentation>Section 5.2 (prose-sec-026, page 64): Trained UAT testers (including end-users and trusted advisers) use the beta PCPOSS in existing workflows and report bugs, design flaws, usability roadblocks and direct feedback to engineers.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="test-plan-execution"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ch5_5</bpmn:incoming>
      <bpmn:incoming>Flow_Ch5_7_ReUat</bpmn:incoming>
      <bpmn:outgoing>Flow_Ch5_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_UatPassed" name="UAT &amp; deployment readiness passed?">
      <bpmn:documentation>Section 5.2 (prose-sec-026, page 64): Determine whether bugs or usability roadblocks require updates to the beta PCPOSS before production deployment, or whether UAT passed for Version 1 release.</bpmn:documentation>
      <bpmn:incoming>Flow_Ch5_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Ch5_7_Fix</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ch5_7_Deploy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_5_2_UpdatePcposs" name="5.2 &amp; 5.4 Address feedback, fix bugs &amp; update PCPOSS release">
      <bpmn:documentation>Chapter 5 opener panel and Sections 5.2, 5.4 (prose-sec-025, prose-sec-026, prose-sec-028): Software engineers take direct end-user and UAT feedback and update the PCPOSS accordingly.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="l4-application-build"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ch5_7_Fix</bpmn:incoming>
      <bpmn:incoming>Flow_Ch5_10_Update</bpmn:incoming>
      <bpmn:outgoing>Flow_Ch5_7_ReUat</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_5_3_DeploySystem" name="5.3 Install site infrastructure/hardware, migrate data, configure &amp; deploy to production">
      <bpmn:documentation>Section 5.3 (prose-sec-027, page 65): Install site infrastructure, deliver hardware, install PCPOSS software, migrate legacy data, load configuration data, set up facility and health-worker accounts, test site hardware, schedule non-disruptive deployment and deploy to production.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="methodology-adoption"/>
      </bpmn:extensionElements>
      <bpmn:ioSpecification id="Task_5_3_DeploySystem_IO">
        <bpmn:dataInput id="Task_5_3_DeploySystem_In_1" name="UAT-validated PCPOSS release"/>
        <bpmn:dataInput id="Task_5_3_DeploySystem_In_2" name="Training materials"/>
        <bpmn:dataOutput id="Task_5_3_DeploySystem_Out_1" name="A deployed and rolled-out PCPOSS"/>
        <bpmn:inputSet id="Task_5_3_DeploySystem_InputSet">
          <bpmn:dataInputRefs>Task_5_3_DeploySystem_In_1</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>Task_5_3_DeploySystem_In_2</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="Task_5_3_DeploySystem_OutputSet">
          <bpmn:dataOutputRefs>Task_5_3_DeploySystem_Out_1</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:incoming>Flow_Ch5_7_Deploy</bpmn:incoming>
      <bpmn:outgoing>Flow_Ch5_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_5_4_FeedbackAndMaintenance" name="5.4 Operate feedback SOP, hardware/software maintenance &amp; impact M&amp;E">
      <bpmn:documentation>Section 5.4 (prose-sec-028, page 65): Operate the central feedback mechanism and SOP, provide continuous training and hardware/software maintenance, and monitor efficiency gains, cost savings and health outcomes to inform scale-up.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-feedback"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ch5_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Ch5_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_MaintenanceUpdate" name="Software update needed from roll-out feedback (5.4)?">
      <bpmn:documentation>Section 5.4 (prose-sec-028, page 65): Route bugs or enhancement requests back to engineering for software updates and re-verification, or complete the roll-out phase with the live PCPOSS ready for Chapter 6 scale-up.</bpmn:documentation>
      <bpmn:incoming>Flow_Ch5_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Ch5_10_Update</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ch5_10_Done</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Ch5" name="Deployed and rolled-out PCPOSS live in production">
      <bpmn:documentation>Chapter 5 opener panel outputs complete: Training materials and a deployed and rolled-out PCPOSS in routine production use.</bpmn:documentation>
      <bpmn:incoming>Flow_Ch5_10_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Ch5_1" sourceRef="Start_Ch5" targetRef="Task_5_0_Policies"/>
    <bpmn:sequenceFlow id="Flow_Ch5_2" sourceRef="Task_5_0_Policies" targetRef="Task_5_1_1_TrainUsers"/>
    <bpmn:sequenceFlow id="Flow_Ch5_3" sourceRef="Task_5_1_1_TrainUsers" targetRef="Task_5_1_2_TrainMaintenance"/>
    <bpmn:sequenceFlow id="Flow_Ch5_4" sourceRef="Task_5_1_2_TrainMaintenance" targetRef="Task_5_2_1_CurateTestCases"/>
    <bpmn:sequenceFlow id="Flow_Ch5_5" sourceRef="Task_5_2_1_CurateTestCases" targetRef="Task_5_2_RunUat"/>
    <bpmn:sequenceFlow id="Flow_Ch5_6" sourceRef="Task_5_2_RunUat" targetRef="GW_UatPassed"/>
    <bpmn:sequenceFlow id="Flow_Ch5_7_Fix" sourceRef="GW_UatPassed" targetRef="Task_5_2_UpdatePcposs" name="bugs or roadblocks found"/>
    <bpmn:sequenceFlow id="Flow_Ch5_7_ReUat" sourceRef="Task_5_2_UpdatePcposs" targetRef="Task_5_2_RunUat"/>
    <bpmn:sequenceFlow id="Flow_Ch5_7_Deploy" sourceRef="GW_UatPassed" targetRef="Task_5_3_DeploySystem" name="UAT passed"/>
    <bpmn:sequenceFlow id="Flow_Ch5_8" sourceRef="Task_5_3_DeploySystem" targetRef="Task_5_4_FeedbackAndMaintenance"/>
    <bpmn:sequenceFlow id="Flow_Ch5_9" sourceRef="Task_5_4_FeedbackAndMaintenance" targetRef="GW_MaintenanceUpdate"/>
    <bpmn:sequenceFlow id="Flow_Ch5_10_Update" sourceRef="GW_MaintenanceUpdate" targetRef="Task_5_2_UpdatePcposs" name="apply software update"/>
    <bpmn:sequenceFlow id="Flow_Ch5_10_Done" sourceRef="GW_MaintenanceUpdate" targetRef="End_Ch5" name="live PCPOSS stable"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_TrainingTestingAndRollOut">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_TrainingTestingAndRollOut" bpmnElement="Collaboration_Process_TrainingTestingAndRollOut">
