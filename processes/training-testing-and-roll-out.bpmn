        <di:waypoint x="595" y="360" />
        <di:waypoint x="620" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Ch5_5" bpmnElement="Flow_Ch5_5">
        <di:waypoint x="710" y="402" />
        <di:waypoint x="710" y="678" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Ch5_6" bpmnElement="Flow_Ch5_6">
